# Product API
API_URL=https://openapi.programming-hero.com/api/bazardor

# MongoDB — BetterAuth (users + sessions only) — tomar Atlas URI boshao
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/

# BetterAuth
BETTER_AUTH_SECRET=generate-one-with-openssl-rand-base64-32
